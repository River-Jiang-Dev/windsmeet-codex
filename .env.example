# WindsMeet Codex — Environment Variables
# Copy this to .env.local and fill in values when needed.
# The static launch has no runtime secrets.

# ─── Build time (optional) ────────────────────────────────────────────────────
# Canonical origin used in metadata, sitemap, and robots.
# Defaults to https://yanyun.mvphubapp.com when unset.
# NEXT_PUBLIC_SITE_URL=https://yanyun.mvphubapp.com

# Workers Builds can fail to load the @swc/core native binding.
# `npm run build` already sets these. Override only if the cache path below
# is not executable in that environment. The cache path must be absolute.
# SWC_NATIVE_BINDING_CACHE=/tmp/swc-native-cache
# SWC_NATIVE_BINDING_CACHE_SKIP_SECURITY_CHECK=1

# ─── Phase 2: Image Storage (Cloudflare R2) ───────────────────────────────────
# Not used by the static site.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=windsmeet-codex-media
# NEXT_PUBLIC_R2_PUBLIC_URL=https://media.your-domain.com

# ─── Phase 2: Database (Supabase) ────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Phase 3: Analytics ───────────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
