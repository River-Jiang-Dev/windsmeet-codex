# WindsMeet Codex — Environment Variables
# Copy this to .env.local and fill in values when needed.

# ─── Phase 2: Image Storage (Cloudflare R2) ───────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=windsmeet-codex-media
# NEXT_PUBLIC_R2_PUBLIC_URL=https://media.your-domain.com

# ─── Phase 2: Database (Supabase) ────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Phase 3: Analytics ───────────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
